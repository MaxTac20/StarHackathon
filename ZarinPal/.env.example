# Application
APP_ENV=development
APP_NAME=ZarinPal Analysis Dashboard
DEBUG=true
LOG_LEVEL=INFO

# Database
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-before-deploying
DATABASE_URL=postgresql+psycopg://app:change-me-before-deploying@localhost:5435/app

# Local seed data (relative paths resolve from this challenge directory)
SEED_DATA_PATH=data/challenge_data.csv

# Security (generate a long random value for every deployed environment)
SECRET_KEY=development-only-change-me

# Server
HOST=0.0.0.0
PORT=8003

# Frontend
# VITE_* values are compiled into the public browser bundle. Never put secrets here.
# VITE_PUBLIC_APP_NAME=ZarinPal Analysis Dashboard
