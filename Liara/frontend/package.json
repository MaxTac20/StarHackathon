    "@tanstack/react-query-devtools": "5.101.4",
    "ai": "^5.0.240",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "1.33.0",
    "motion": "^13.1.0",
    "nanoid": "^6.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.85.0",
    "react-router": "8.3.0",
